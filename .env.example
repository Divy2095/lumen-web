# Optional public identifier from your own Clerk development application.
# Copy to ignored .env.local, supply the real publishable key, then rebuild.
# Never put Clerk secret keys or project API keys in VITE_ variables.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional local Phase 8C API origin, not the /lumen-web/ website path.
# Copy to ignored .env.local for your local demo only, then restart/rebuild.
# VITE_LUMEN_API_BASE_URL=http://127.0.0.1:3000
