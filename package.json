{
  "name": "lumen-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1",
    "typecheck": "react-router typegen && tsc --noEmit",
    "build": "node scripts/validate-docs.ts source && react-router build && node scripts/finalize-static.ts && pagefind --site build/client --root-selector article --force-language en && node scripts/validate-docs.ts output",
    "preview": "node scripts/static-server.ts",
    "test": "node scripts/finalize-static.test.ts && node scripts/documentation.test.ts && playwright test",
    "check:docs": "node scripts/validate-docs.ts output",
    "validate": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@clerk/react": "6.18.7",
    "isbot": "5.2.3",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "1.65.0",
    "@react-router/dev": "8.5.1",
    "@shikijs/rehype": "4.6.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/mdx": "2.0.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pagefind": "1.6.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
